{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cerebrosesponjosos.com" }],
      "destination": "https://www.cerebrosesponjosos.com/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
